# Ignore node_modules everywhere
node_modules/
**/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist
dist-ssr
.cache/
.vite/
coverage/

# Local files
*.local
.env
.env.local
.env.*.local

# TypeScript buildinfo and temp
**/*.tsbuildinfo
node_modules/.tmp/

# Python (rag-service-node)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
ENV/
.envrc
.pytest_cache/
.mypy_cache/

# Java / Maven / Gradle (backend-spring)
target/
*.class
*.jar
*.war
*.ear
.gradle/
.build/
.mvn/
.classpath
.project
.settings/

# Runtime / logs
*.pid
*.seed
*.pid.lock

# Local DB
*.db
*.sqlite
*.sqlite3

# Editor swap / backup
*~
*.swp

# Platform files
Thumbs.db
.DS_Store

# Editor directories and files (allow recommended VSCode extensions file)
.vscode/*
!.vscode/extensions.json
.idea

# Node lockfiles: ensure pnpm lock is committed; ignore other lock files
package-lock.json
yarn.lock
# DO NOT ignore pnpm-lock.yaml

# Ruff (Python linter)
.ruff_cache/

# JaCoCo (Java coverage)
backend-spring/target/site/jacoco/

# Wiki submodule & draft files
qa-system.wiki/
bug.md

# End of file
