    "/api/image-search": {
      "post": {
        "tags": [
          "ImageSearch"
        ],
        "summary": "以图搜图（上传图片，CLIP 优先 / pHash 兜底）",
        "operationId": "search_by_image_api_image_search_post",
        "parameters": [
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Top K"
            }
          },
          {
            "name": "threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 64,
              "minimum": 0,
              "description": "pHash 模式下 Hamming 距离阈值",
              "default": 20,
              "title": "Threshold"
            },
            "description": "pHash 模式下 Hamming 距离阈值"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(auto|clip|phash)$",
              "default": "auto",
              "title": "Model"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(zh|en)$",
              "default": "zh",
              "title": "Lang"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_search_by_image_api_image_search_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
